{
  "name": "reservas-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "test": "vitest run --project unit",
    "test:integration:check": "node scripts/check-test-config.js",
    "test:integration": "node scripts/check-test-config.js && vitest run --project integration",
    "tenant:status": "node scripts/tenant-status.js",
    "demo:seed": "node scripts/seed-demo.js",
    "e2e:server": "node scripts/check-test-config.js && node scripts/e2e-server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
