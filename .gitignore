# Dependencias y compilación
node_modules/
dist/
coverage/

# Variables de entorno: solo se publican las plantillas sin credenciales
.env
.env.*
!.env.example
!.env.test.example

# Correos de confirmación generados en modo de prueba
.mail-outbox/

# Cachés, registros y temporales
.npm-cache/
.vite/
*.log
*.tmp
.DS_Store
Thumbs.db

# Certificados y claves privadas
*.pem
*.key
*.crt
*.p12
*.pfx

# Configuración local de herramientas y editores
.claude/settings.local.json
.vscode/
.idea/

# Resultados temporales de la E2E (las capturas seleccionadas están en docs/evidencias/)
test-results/
playwright-report/

# Material del curso entregado por el docente (consigna, rúbrica y guía): se conserva en local, no se publica
referencias/*.pdf
referencias/*.html
